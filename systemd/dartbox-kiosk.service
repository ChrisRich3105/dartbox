[Unit]
Description=Dartbox kiosk browser (only shows something when a monitor is connected)
After=systemd-user-sessions.service plymouth-quit-wait.service dartbox-web.service
Wants=dartbox-web.service
Conflicts=getty@tty7.service

[Service]
User=dartbox
PAMName=login
WorkingDirectory=~
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
ExecStartPre=+/bin/chvt 7
ExecStart=/usr/local/bin/dartbox-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
