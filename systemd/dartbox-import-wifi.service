[Unit]
Description=Dartbox: import WiFi migrated from /etc/network/interfaces
ConditionPathExists=/var/lib/dartbox/pending-wifi
After=NetworkManager.service
Wants=NetworkManager.service
Before=dartbox-netmgr.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 5
ExecStart=/usr/local/bin/dartbox-import-wifi

[Install]
WantedBy=multi-user.target
