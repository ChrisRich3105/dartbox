#!/usr/bin/env python3
"""dartbox-update: online updates from the project's GitHub releases/tags.

  dartbox-update check          ask GitHub for newer versions (writes latest.json)
  dartbox-update status         show installed / latest / last update result
  dartbox-update apply [TAG]    install TAG (default: newest), self-test, auto-rollback on failure
  dartbox-update rollback       go back to the previously installed version
  dartbox-update list           versions kept on this box

Layout:
  /opt/dartbox/versions/<ver>/   complete source tree of each installed version
  /opt/dartbox/current           symlink to the active version (set by install.sh)
  /var/lib/dartbox/update/       latest.json, status.json, previous, update.log
  /var/lib/dartbox/backups/      settings + playroom data, saved before every update

An update: download tag tarball -> back up settings/statistics -> run its install.sh --update
-> dartbox-selftest. If installing or the self-test fails, the previous version is reinstalled
and the backup restored. "rollback" does the same on request (without restoring data, so
statistics recorded since the update are kept).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/local/lib/dartbox")
from dartbox_common import release_info  # noqa: E402

# DARTBOX_OPT / DARTBOX_VAR only exist for testing outside a real box
BASE = os.environ.get("DARTBOX_OPT", "/opt/dartbox")
VAR = os.environ.get("DARTBOX_VAR", "/var/lib/dartbox")
VERSIONS = os.path.join(BASE, "versions")
CURRENT = os.path.join(BASE, "current")
UPD = os.path.join(VAR, "update")
BACKUPS = os.path.join(VAR, "backups")
LATEST = os.path.join(UPD, "latest.json")
STATUS = os.path.join(UPD, "status.json")
PREVIOUS = os.path.join(UPD, "previous")
LOG = os.path.join(UPD, "update.log")
DATA_PATHS = ["/etc/dartbox", "/var/lib/dartbox/playroom"]
HEADERS = {"User-Agent": "dartbox-updater", "Accept": "application/vnd.github+json"}
TAG_RE = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?$")
BUSY = ("downloading", "installing", "testing", "rollingback")


# ------------------------------------------------------------------ helpers
def vkey(v):
    """Sort key for 'v1.2.3' / '1.2.3-beta.1'; None if not a version. Pre-releases sort before releases."""
    m = TAG_RE.match(str(v).strip())
    if not m:
        return None
    pre = m.group(4)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), 0 if pre else 1, pre or "")


def plain(v):
    return str(v).strip().lstrip("v")


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def extract(tar, dest):
    """extractall with the safe 'data' filter where Python supports it (3.11.4+)."""
    if hasattr(tarfile, "data_filter"):
        tar.extractall(dest, filter="data")
    else:
        tar.extractall(dest)


def log(msg):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    print(line, flush=True)
    os.makedirs(UPD, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def set_status(state, message="", **extra):
    st = {"state": state, "message": message, "time": time.time(), "pid": os.getpid(), **extra}
    write_json(STATUS, st)
    log(f"[{state}] {message}")


def installed_version():
    try:
        return os.path.basename(os.path.realpath(CURRENT)) if os.path.islink(CURRENT) else release_info()["version"]
    except OSError:
        return release_info()["version"]


def previous_version():
    try:
        with open(PREVIOUS) as f:
            v = f.read().strip()
        return v if v and os.path.isdir(os.path.join(VERSIONS, v)) else None
    except OSError:
        return None


def set_previous(v):
    try:
        if v:
            with open(PREVIOUS, "w") as f:
                f.write(v + "\n")
        elif os.path.exists(PREVIOUS):
            os.remove(PREVIOUS)
    except OSError as e:
        log(f"previous: {e}")


def get_json(url):
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())


def run(cmd, timeout=1800):
    """Run a command, append its output to the update log, return exit code."""
    log("$ " + " ".join(cmd))
    with open(LOG, "a") as f:
        try:
            p = subprocess.run(cmd, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, timeout=timeout)
            return p.returncode
        except subprocess.TimeoutExpired:
            log("timeout")
            return 124


def busy():
    st = read_json(STATUS, {}) or {}
    if st.get("state") in BUSY and st.get("pid") and st["pid"] != os.getpid():
        try:
            os.kill(st["pid"], 0)
            return True
        except OSError:
            return False
    return False


# ------------------------------------------------------------------ check
def check(quiet=False):
    info = release_info()
    cur = installed_version()
    result = {"checked": time.time(), "installed": cur, "repo": info["repo"], "channel": info["channel"],
              "update_available": False, "tag": None, "notes": "", "releases": []}
    if not info["repo"]:
        result["error"] = "No GitHub repository configured (release.conf: GITHUB_REPO)."
        write_json(LATEST, result)
        return result
    beta = info["channel"] == "beta"
    try:
        rels = get_json(f"https://api.github.com/repos/{info['repo']}/releases?per_page=30")
        rels = [r for r in rels if not r.get("draft") and vkey(r.get("tag_name", ""))
                and (beta or not r.get("prerelease"))]
        if rels:
            entries = [{"tag": r["tag_name"], "name": r.get("name") or r["tag_name"], "notes": r.get("body") or "",
                        "published": r.get("published_at"), "url": r.get("html_url"),
                        "prerelease": bool(r.get("prerelease"))} for r in rels]
        else:
            # no GitHub releases (only tags): offer tags without notes
            tags = get_json(f"https://api.github.com/repos/{info['repo']}/tags?per_page=100")
            entries = [{"tag": t["name"], "name": t["name"], "notes": "", "published": None,
                        "url": f"https://github.com/{info['repo']}/releases/tag/{t['name']}",
                        "prerelease": "-" in t["name"]}
                       for t in tags if vkey(t["name"]) and (beta or "-" not in t["name"])]
    except (urllib.error.URLError, OSError, ValueError) as e:
        result["error"] = f"Could not reach GitHub: {e}"
        old = read_json(LATEST, {}) or {}
        old.update(error=result["error"], checked=result["checked"], installed=cur)
        write_json(LATEST, old)
        return old
    entries.sort(key=lambda e: vkey(e["tag"]), reverse=True)
    ck = vkey(cur)
    newer = [e for e in entries if ck is None or vkey(e["tag"]) > ck]
    if entries:
        result["tag"] = entries[0]["tag"]
        result["name"] = entries[0]["name"]
        result["url"] = entries[0]["url"]
    result["update_available"] = bool(newer)
    result["releases"] = newer[:15]
    # release notes of every version between the installed one and the newest
    result["notes"] = "\n\n".join(f"## {e['name']}\n\n{e['notes'].strip() or '_No release notes._'}" for e in newer[:15])
    write_json(LATEST, result)
    if not quiet:
        print(f"installed {cur}, newest {result['tag']}, update available: {result['update_available']}")
    return result


# ------------------------------------------------------------------ install helpers
def download(repo, tag):
    url = f"https://github.com/{repo}/archive/refs/tags/{tag}.tar.gz"
    log(f"downloading {url}")
    tmp = tempfile.mkdtemp(prefix="dartbox-update-")
    archive = os.path.join(tmp, "src.tar.gz")
    req = urllib.request.Request(url, headers={"User-Agent": "dartbox-updater"})
    with urllib.request.urlopen(req, timeout=60) as r, open(archive, "wb") as f:
        shutil.copyfileobj(r, f)
    with tarfile.open(archive) as t:
        for m in t.getmembers():               # refuse absolute paths / ../ tricks
            if m.name.startswith("/") or ".." in m.name.split("/"):
                raise RuntimeError(f"unsafe path in archive: {m.name}")
        extract(t, tmp)
    tops = [d for d in os.listdir(tmp) if os.path.isdir(os.path.join(tmp, d))]
    if len(tops) != 1 or not os.path.isfile(os.path.join(tmp, tops[0], "install.sh")):
        raise RuntimeError("downloaded archive does not look like a dartbox release")
    src = os.path.join(tmp, tops[0])
    try:
        with open(os.path.join(src, "VERSION")) as f:
            ver = f.read().strip() or plain(tag)
    except OSError:
        ver = plain(tag)
    dest = os.path.join(VERSIONS, ver)
    os.makedirs(VERSIONS, exist_ok=True)
    if os.path.realpath(dest) == os.path.realpath(CURRENT):
        raise RuntimeError(f"version {ver} is already the active version")
    shutil.rmtree(dest, ignore_errors=True)
    shutil.move(src, dest)
    shutil.rmtree(tmp, ignore_errors=True)
    return ver, dest


def backup(label):
    os.makedirs(BACKUPS, exist_ok=True)
    path = os.path.join(BACKUPS, f"{time.strftime('%Y%m%d-%H%M%S')}-before-{label}.tar.gz")
    with tarfile.open(path, "w:gz") as t:
        for p in DATA_PATHS:
            if os.path.exists(p):
                t.add(p)
    # keep the 10 newest backups
    files = sorted(os.listdir(BACKUPS))
    for old in files[:-10]:
        os.remove(os.path.join(BACKUPS, old))
    log(f"backup written: {path}")
    return path


def restore(path):
    log(f"restoring backup {path}")
    with tarfile.open(path) as t:
        extract(t, "/")


def install_from(directory):
    return run(["bash", os.path.join(directory, "install.sh"), "--update"])


def selftest():
    return run(["/usr/local/bin/dartbox-selftest", "--wait", "90"], timeout=200) == 0


def prune():
    keep = {installed_version(), previous_version()}
    others = sorted((v for v in os.listdir(VERSIONS) if v not in keep),
                    key=lambda v: vkey(v) or (0,), reverse=True)
    for v in others[1:]:                      # current + previous + one more
        shutil.rmtree(os.path.join(VERSIONS, v), ignore_errors=True)
        log(f"removed old version {v}")


# ------------------------------------------------------------------ apply / rollback
def apply(tag=None):
    if busy():
        print("another update is running")
        return 1
    open(LOG, "w").close()
    info = release_info()
    if not info["repo"]:
        set_status("failed", "No GitHub repository configured.")
        return 1
    if not tag:
        tag = (check(quiet=True) or {}).get("tag")
        if not tag:
            set_status("failed", "No release found.")
            return 1
    if not vkey(tag):
        set_status("failed", f"Not a version tag: {tag}")
        return 1
    old = installed_version()
    prev_before = previous_version()
    try:
        set_status("downloading", f"Downloading {tag} …", target=tag, from_version=old)
        ver, dest = download(info["repo"], tag)
        bk = backup(ver)
        set_status("installing", f"Installing {ver} …", target=tag, from_version=old, backup=bk)
        if install_from(dest) != 0:
            raise RuntimeError("the installer reported an error")
        set_status("testing", f"Testing {ver} …", target=tag, from_version=old, backup=bk)
        if not selftest():
            raise RuntimeError("the self-test failed")
    except Exception as e:  # noqa: BLE001 - anything means: go back
        reason = str(e)
        old_dir = os.path.join(VERSIONS, old)
        if os.path.isdir(old_dir) and os.path.isfile(os.path.join(old_dir, "install.sh")) and plain(old) != plain(tag):
            set_status("rollingback", f"Update failed ({reason}) – going back to {old} …", target=tag, from_version=old)
            install_from(old_dir)
            set_previous(prev_before)          # the installer recorded the failed version as "previous"
            if "bk" in locals():
                restore(bk)
                run(["systemctl", "try-restart", "dartbox-web", "dartbox-playroom", "dartbox-netmgr"])
            ok = selftest()
            set_status("rolledback", f"Update to {tag} failed ({reason}). Back on {old}"
                       + ("" if ok else " – but the self-test still fails, see the log") + ".",
                       target=tag, from_version=old)
        else:
            set_status("failed", f"Update to {tag} failed: {reason}", target=tag, from_version=old)
        check(quiet=True)
        return 1
    set_status("done", f"Updated from {old} to {ver}.", target=tag, from_version=old)
    try:
        prune()
    except OSError as e:
        log(f"prune: {e}")
    check(quiet=True)
    return 0


def rollback():
    if busy():
        print("another update is running")
        return 1
    open(LOG, "w").close()
    prev, cur = previous_version(), installed_version()
    if not prev:
        set_status("failed", "No previous version available to roll back to.")
        return 1
    set_status("rollingback", f"Going back from {cur} to {prev} …", target=prev, from_version=cur)
    if install_from(os.path.join(VERSIONS, prev)) != 0 or not selftest():
        set_status("failed", f"Rollback to {prev} had problems – see the log.", target=prev, from_version=cur)
        return 1
    set_status("done", f"Rolled back from {cur} to {prev}. (You can update again at any time.)",
               target=prev, from_version=cur)
    check(quiet=True)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd in ("apply", "rollback", "check") and os.geteuid() != 0:
        print("run as root")
        return 1
    if cmd == "check":
        if not release_info()["check_enabled"] and "--force" not in argv:
            print("update checks disabled (UPDATE_CHECK=0)")
            return 0
        r = check()
        return 0 if not r.get("error") else 1
    if cmd == "apply":
        return apply(argv[2] if len(argv) > 2 else None)
    if cmd == "rollback":
        return rollback()
    if cmd == "list":
        cur, prev = installed_version(), previous_version()
        for v in sorted(os.listdir(VERSIONS) if os.path.isdir(VERSIONS) else [], key=lambda v: vkey(v) or (0,)):
            print(v, "(active)" if v == cur else "(previous)" if v == prev else "")
        return 0
    if cmd == "status":
        print(json.dumps({"installed": installed_version(), "previous": previous_version(),
                          "latest": read_json(LATEST), "status": read_json(STATUS)}, indent=2))
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
