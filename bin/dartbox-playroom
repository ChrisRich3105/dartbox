#!/usr/bin/env python3
"""dartbox-playroom: local darts games + training, no cloud needed (port 8081).

Serves the playroom web app and a small JSON API:

  GET    /api/players                    remembered player names
  POST   /api/players        {name}      add (or return existing) player
  PUT    /api/players/<id>   {name}      rename
  DELETE /api/players/<id>               forget player (history is kept)
  POST   /api/players/touch  {ids:[..]}  mark players as recently used

  GET    /api/history[?player=<id>]      finished games / training sessions
  POST   /api/history        {...}       store a finished game
  DELETE /api/history/<id>               delete one record

  GET    /api/active                     running game (for resume / remote keypad)
  PUT    /api/active         {...}       host saves the running game
  DELETE /api/active                     game finished / abandoned

  GET    /api/input?since=N              remote keypad inputs for the host
  POST   /api/input          {...}       remote keypad sends a dart / undo / next

  GET    /api/about                      version, support link, update hint, default language
  GET    /api/voices                     natural caller voices installed on the box {"de": true, …}
  GET    /api/say?lang=&style=&text=     caller phrase as WAV (Piper TTS, cached on disk)
  GET    /api/board                      normalised Autodarts board manager state
  POST   /api/board/reset                reset the board manager (stuck takeout)
  GET    /api/board/status               board health: detection running, calibration, cameras
  GET    /api/board/image                live camera picture (JPEG) from the board manager
  POST   /api/board/{calibrate|start|stop|restart}   board manager commands

Data lives in /var/lib/dartbox/playroom (override with DARTBOX_PLAYROOM_DATA).
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import urllib.error
import urllib.parse
import time
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, "/usr/local/lib/dartbox")
try:
    from dartbox_common import load_config, release_info
except ImportError:                                    # running outside the box
    def load_config():
        return {"BOARD_MANAGER_URL": "http://localhost:3180"}

    def release_info():
        return {"version": "dev", "support_url": ""}

# ------------------------------------------------------------------ natural caller voice (Piper TTS)
PIPER = os.environ.get("DARTBOX_PIPER", "/opt/dartbox/piper/piper")
VOICES_DIR = os.environ.get("DARTBOX_VOICES", "/var/lib/dartbox/voices")
VOICE_CACHE = os.environ.get("DARTBOX_VOICE_CACHE", "/var/lib/dartbox/voice-cache")
DEFAULT_VOICES = {"de": "de_DE-thorsten_emotional-medium", "en": "en_GB-alan-medium"}
# speaking style -> speaker names to try (multi-speaker voices such as the emotional Thorsten)
STYLE_SPEAKERS = {"calm": ["neutral"], "hype": ["surprised", "amused"]}


class PiperVoice:
    """One long-running piper process (--json-input) per voice: the model stays loaded."""

    def __init__(self, lang, name):
        self.lang, self.name = lang, name
        self.model = os.path.join(VOICES_DIR, name + ".onnx")
        self.proc = None
        self.lock = threading.Lock()
        try:
            with open(self.model + ".json", encoding="utf-8") as f:
                self.speakers = json.load(f).get("speaker_id_map") or {}
        except (OSError, ValueError):
            self.speakers = {}

    def available(self):
        return os.path.isfile(PIPER) and os.path.isfile(self.model)

    def speaker(self, style):
        if not self.speakers:
            return None
        for name in STYLE_SPEAKERS.get(style, []) + ["neutral"]:
            if name in self.speakers:
                return self.speakers[name]
        return next(iter(self.speakers.values()))

    def _start(self):
        cmd = [PIPER, "--model", self.model, "--json-input"]
        if shutil.which("nice"):
            cmd = ["nice", "-n", "10"] + cmd            # never slow down the board / UI
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True, encoding="utf-8", bufsize=1)

    def synth(self, text, style):
        """Return the path of a cached WAV for text, generating it if needed."""
        sid = self.speaker(style)
        key = hashlib.sha1(f"{self.name}|{sid}|{text}".encode("utf-8")).hexdigest()
        folder = os.path.join(VOICE_CACHE, self.lang)
        path = os.path.join(folder, key + ".wav")
        if os.path.isfile(path):
            return path
        os.makedirs(folder, exist_ok=True)
        tmp = path + ".part.wav"
        req = {"text": text, "output_file": tmp}
        if sid is not None:
            req["speaker_id"] = sid
        with self.lock:
            if os.path.isfile(path):
                return path
            for attempt in range(2):
                try:
                    if not self.proc or self.proc.poll() is not None:
                        self._start()
                    self.proc.stdin.write(json.dumps(req, ensure_ascii=False) + "\n")
                    self.proc.stdin.flush()
                    deadline = time.monotonic() + 30
                    while time.monotonic() < deadline:            # piper prints the file name when done
                        line = self.proc.stdout.readline()
                        if not line:
                            raise RuntimeError("piper exited")
                        if line.strip().endswith(os.path.basename(tmp)) or line.strip() == tmp:
                            break
                    if os.path.isfile(tmp) and os.path.getsize(tmp) > 44:
                        os.replace(tmp, path)
                        return path
                    raise RuntimeError("no audio produced")
                except Exception:  # noqa: BLE001 - restart piper once, then give up
                    try:
                        self.proc and self.proc.kill()
                    except OSError:
                        pass
                    self.proc = None
        return None


VOICES = {}                                   # voice name -> PiperVoice (one process each, started on first use)
VOICE_NAME_RE = re.compile(r"^([a-z]{2})_[A-Z]{2}-[A-Za-z0-9_]+-(x_low|low|medium|high)$")


def installed_voices():
    """All Piper voices in VOICES_DIR: [{id, lang, label, quality, styles, default}]."""
    cfg = load_config()
    defaults = {lang: cfg.get(f"CALLER_VOICE_{lang.upper()}", DEFAULT_VOICES.get(lang, "")) for lang in DEFAULT_VOICES}
    out = []
    if not os.path.isfile(PIPER):
        return out
    try:
        files = sorted(os.listdir(VOICES_DIR))
    except OSError:
        return out
    for f in files:
        name = f[:-5] if f.endswith(".onnx") else None
        m = VOICE_NAME_RE.match(name or "")
        if not m or not os.path.isfile(os.path.join(VOICES_DIR, f + ".json")):
            continue
        lang, quality = m.group(1), m.group(2)
        speaker = name.split("-")[1]
        try:
            with open(os.path.join(VOICES_DIR, f + ".json"), encoding="utf-8") as fh:
                speakers = json.load(fh).get("speaker_id_map") or {}
        except (OSError, ValueError):
            speakers = {}
        out.append({
            "id": name, "lang": lang, "quality": quality,
            "label": " ".join(w.capitalize() for w in speaker.split("_")),
            "styles": any(n in speakers for n in STYLE_SPEAKERS["hype"]),   # has an excited speaking style
            "default": defaults.get(lang) == name,
        })
    return out


def voice_for(lang, name=None):
    """The Piper voice for a language: the requested one if installed, else the box default."""
    if not name:
        name = load_config().get(f"CALLER_VOICE_{lang.upper()}", DEFAULT_VOICES.get(lang, ""))
    if not name or not VOICE_NAME_RE.match(name) or not name.startswith(lang + "_"):
        return None
    v = VOICES.get(name)
    if not v:
        v = VOICES[name] = PiperVoice(lang, name)
    return v if v.available() else None


def voices_available():
    lst = installed_voices()
    out = {lang: any(v["lang"] == lang for v in lst) for lang in DEFAULT_VOICES}
    out["list"] = lst
    return out


def clean_text(t):
    t = "".join(ch for ch in str(t) if ch.isprintable())
    return " ".join(t.split())[:160]


def about():
    rel = release_info()
    latest = read_json(os.path.join(os.environ.get("DARTBOX_VAR", "/var/lib/dartbox"), "update", "latest.json"), {}) or {}
    return {"version": rel.get("version"), "support_url": rel.get("support_url", ""),
            "update_available": bool(latest.get("update_available")) and latest.get("installed") == rel.get("version"),
            "update_tag": latest.get("tag"),
            "language": load_config().get("LANGUAGE", "auto")}

DATA = os.environ.get("DARTBOX_PLAYROOM_DATA", "/var/lib/dartbox/playroom")
STATIC = os.environ.get("DARTBOX_PLAYROOM_STATIC", "/usr/local/share/dartbox/playroom")
PORT = int(os.environ.get("DARTBOX_PLAYROOM_PORT", "8081"))
PLAYERS = os.path.join(DATA, "players.json")
HISTORY = os.path.join(DATA, "history.jsonl")
ACTIVE = os.path.join(DATA, "active.json")

LOCK = threading.Lock()
INPUT = {"seq": 0, "items": []}          # remote keypad queue (in memory)
BOARD_CACHE = {"t": 0.0, "data": None}
SYSTEM_CACHE = {"t": 0.0, "data": None}

MIME = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
        ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".json": "application/json",
        ".png": "image/png", ".ico": "image/x-icon"}


# ------------------------------------------------------------------ storage
def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_history():
    out = []
    try:
        with open(HISTORY, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except OSError:
        pass
    return out


def write_history(records):
    tmp = HISTORY + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        for r in records:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    os.replace(tmp, HISTORY)


# ------------------------------------------------------------------ board manager
def norm_dart(t):
    """Board manager dart (2.0 nested or 2.1 flat) -> {n, m, name}. n=25 is bull, m=0 is a miss."""
    seg = t.get("segment") if isinstance(t.get("segment"), dict) else None
    if seg is not None:
        name, num, mult, bed = seg.get("name"), seg.get("number"), seg.get("multiplier"), seg.get("bed")
    else:
        name, num, mult, bed = t.get("segmentName"), t.get("segmentNumber"), t.get("multiplier"), t.get("bed")
    try:
        num, mult = int(num or 0), int(mult or 0)
    except (TypeError, ValueError):
        num, mult = 0, 0
    if bed == "Outside" or mult <= 0 or num <= 0:
        return {"n": 0, "m": 0, "name": name or "Miss"}
    if num == 25 or str(name).lower().startswith("bull"):
        return {"n": 25, "m": 2 if mult >= 2 else 1, "name": name}
    return {"n": num, "m": max(1, min(3, mult)), "name": name}


def board_state():
    now = time.monotonic()
    with LOCK:
        if BOARD_CACHE["data"] is not None and now - BOARD_CACHE["t"] < 0.2:
            return BOARD_CACHE["data"]
    url = bm_url("/api/state")
    try:
        with urllib.request.urlopen(url, timeout=1.5) as r:
            st = json.loads(r.read() or b"{}")
        data = {
            "ok": True,
            "connected": bool(st.get("connected", True)),
            "running": bool(st.get("running", True)),
            # "Takeout in progress" / "takeoutInProgress" -> "takeoutinprogress"
            "status": str(st.get("status", "")).replace(" ", "").lower(),
            "event": str(st.get("event", "")).replace(" ", "").lower(),
            "throws": [norm_dart(t) for t in (st.get("throws") or []) if isinstance(t, dict)],
        }
    except Exception as e:  # board manager not installed / not running
        data = {"ok": False, "error": str(e)[:200], "throws": []}
    with LOCK:
        BOARD_CACHE.update(t=now, data=data)
    return data


def bm_url(path):
    return load_config().get("BOARD_MANAGER_URL", "http://localhost:3180").rstrip("/") + path


# playroom name -> board manager endpoint (commands are POSTs; PUT is tried if a version wants that)
BOARD_COMMANDS = {
    "reset": "/api/reset",                              # clears a stuck takeout / the current visit
    "calibrate": "/api/config/calibration/auto",        # automatic calibration of all cameras
    "start": "/api/start",                              # dart detection on
    "stop": "/api/stop",                                # dart detection off
    "restart": "/api/restart",                          # restart the cameras / detection
}


def board_command(name):
    for method in ("POST", "PUT"):
        req = urllib.request.Request(bm_url(BOARD_COMMANDS[name]), data=b"", method=method)
        try:
            with urllib.request.urlopen(req, timeout=8):
                return True, ""
        except urllib.error.HTTPError as e:
            if e.code in (404, 405):
                continue
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)[:200]
    return False, "not supported by this board manager version"


def board_reset():
    return board_command("reset")[0]


def board_status():
    """Compact health summary from the board manager's /api/system (+ /api/state as fallback)."""
    now = time.monotonic()
    with LOCK:
        if SYSTEM_CACHE["data"] is not None and now - SYSTEM_CACHE["t"] < 1.0:
            return SYSTEM_CACHE["data"]
    try:
        with urllib.request.urlopen(bm_url("/api/system"), timeout=2.5) as r:
            sysd = json.loads(r.read() or b"{}")
        cal = sysd.get("calibration") or {}
        status = sysd.get("status") or {}
        turn = sysd.get("turn") or {}
        fps = {c.get("id"): c.get("fps") for c in (sysd.get("camStats") or []) if isinstance(c, dict)}
        cams = []
        for i, c in enumerate(cal.get("cams") or []):
            cams.append({
                "calibrated": bool(c.get("calibrated")), "calibrating": bool(c.get("calibrating")),
                "failed": bool(c.get("fitFailed")),
                "error_px": round(float(c["errorPx"]), 2) if isinstance(c.get("errorPx"), (int, float)) else None,
                "fps": fps.get(i),
            })
        cam_state = sysd.get("camState") or {}
        stats = sysd.get("stats") or {}
        data = {
            "ok": True,
            "version": status.get("version"),
            "running": bool(turn.get("running", cam_state.get("isRunning", True))),
            "cams_open": bool(cam_state.get("isOpened", True)),
            "status": str(turn.get("status", "")).replace(" ", "").lower(),
            "event": str(turn.get("event", "")).replace(" ", "").lower(),
            "throws": [norm_dart(t) for t in (turn.get("throws") or []) if isinstance(t, dict)],
            "calibrated": bool(status.get("calibrated", cal.get("calibrated", False))),
            "calibrating": int(status.get("calibratingCams") or 0) > 0 or any(c["calibrating"] for c in cams),
            "blocker": status.get("blocker") or "none",
            "online": status.get("link") == "connected",
            "cams": cams,
            "cpu": round(stats["cpuPercent"]) if isinstance(stats.get("cpuPercent"), (int, float)) else None,
        }
    except Exception as e:  # older board manager without /api/system, or not running
        st = board_state()
        data = dict(st, version=None, calibrated=None, calibrating=False, cams=[], blocker="none")
        if not st.get("ok"):
            data["error"] = st.get("error") or str(e)[:200]
    with LOCK:
        SYSTEM_CACHE.update(t=now, data=data)
    return data


def board_image():
    try:
        with urllib.request.urlopen(bm_url("/api/img/live"), timeout=4) as r:
            return r.read(), r.headers.get("Content-Type", "image/jpeg")
    except Exception:
        return None, None


# ------------------------------------------------------------------ HTTP
class Handler(BaseHTTPRequestHandler):
    server_version = "dartbox-playroom"

    def log_message(self, fmt, *args):
        pass

    def do_HEAD(self):                     # used to pre-render caller phrases without downloading them
        self.head_only = True
        self.do_GET()

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (
            json.dumps(body, ensure_ascii=False) if not isinstance(body, str) else body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store" if ctype != "audio/wav" else "max-age=86400")
        self.end_headers()
        if not getattr(self, "head_only", False):
            self.wfile.write(data)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 5_000_000:
            return {}
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            return {}

    def parts(self):
        path, _, query = self.path.partition("?")
        q = dict(p.split("=", 1) for p in query.split("&") if "=" in p)
        return [p for p in path.split("/") if p], q

    # -------------------------------------------------------------- GET
    def do_GET(self):
        parts, q = self.parts()
        if parts[:1] != ["api"]:
            return self.static(parts)
        what = parts[1] if len(parts) > 1 else ""
        if what == "players":
            players = read_json(PLAYERS, [])
            players.sort(key=lambda p: -p.get("lastUsed", 0))
            return self.send(200, players)
        if what == "history":
            recs = read_history()
            pid = q.get("player")
            if pid:
                recs = [r for r in recs if any(p.get("id") == pid for p in r.get("players", []))]
            return self.send(200, recs)
        if what == "active":
            return self.send(200, read_json(ACTIVE, None))
        if what == "input":
            since = int(q.get("since", "0") or 0)
            with LOCK:
                items = [i for i in INPUT["items"] if i["seq"] > since]
                return self.send(200, {"seq": INPUT["seq"], "items": items})
        if what == "about":
            return self.send(200, about())
        if what == "voices":
            return self.send(200, voices_available())
        if what == "say":
            qs = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            lang = (qs.get("lang") or ["en"])[0]
            style = (qs.get("style") or ["calm"])[0]
            text = clean_text((qs.get("text") or [""])[0])
            want = (qs.get("voice") or [""])[0]
            v = voice_for(lang, want) if lang in DEFAULT_VOICES else None
            if not v and want:
                v = voice_for(lang)                     # chosen voice was removed -> box default
            if not v or not text:
                return self.send(404, {"error": "no natural voice for this language"})
            path = v.synth(text, "hype" if style == "hype" else "calm")
            if not path:
                return self.send(503, {"error": "voice generation failed"})
            with open(path, "rb") as f:
                return self.send(200, f.read(), "audio/wav")
        if what == "board" and len(parts) > 2 and parts[2] == "status":
            return self.send(200, board_status())
        if what == "board" and len(parts) > 2 and parts[2] == "image":
            img, ctype = board_image()
            if img is None:
                return self.send(503, {"error": "no camera picture"})
            return self.send(200, img, ctype)
        if what == "board":
            return self.send(200, board_state())
        return self.send(404, {"error": "not found"})

    def static(self, parts):
        rel = "/".join(parts) or "index.html"
        path = os.path.realpath(os.path.join(STATIC, rel))
        if not path.startswith(os.path.realpath(STATIC)) or not os.path.isfile(path):
            path = os.path.join(STATIC, "index.html")
        with open(path, "rb") as f:
            data = f.read()
        return self.send(200, data, MIME.get(os.path.splitext(path)[1], "application/octet-stream"))

    # -------------------------------------------------------------- POST / PUT / DELETE
    def do_POST(self):
        parts, _ = self.parts()
        data = self.body()
        what = parts[1] if len(parts) > 1 else ""
        sub = parts[2] if len(parts) > 2 else ""
        if what == "players" and sub == "touch":
            ids = set(data.get("ids") or [])
            with LOCK:
                players = read_json(PLAYERS, [])
                now = time.time()
                for p in players:
                    if p["id"] in ids:
                        p["lastUsed"] = now
                write_json(PLAYERS, players)
            return self.send(200, {"ok": True})
        if what == "players":
            name = " ".join(str(data.get("name", "")).split())[:24]
            if not name:
                return self.send(400, {"error": "name required"})
            with LOCK:
                players = read_json(PLAYERS, [])
                for p in players:
                    if p["name"].lower() == name.lower():
                        return self.send(200, p)
                p = {"id": uuid.uuid4().hex[:10], "name": name, "created": time.time(), "lastUsed": time.time()}
                players.append(p)
                write_json(PLAYERS, players)
            return self.send(200, p)
        if what == "history":
            data.setdefault("id", uuid.uuid4().hex[:12])
            data.setdefault("ts", time.time())
            with LOCK, open(HISTORY, "a", encoding="utf-8") as f:
                f.write(json.dumps(data, ensure_ascii=False) + "\n")
            return self.send(200, {"ok": True, "id": data["id"]})
        if what == "input":
            with LOCK:
                INPUT["seq"] += 1
                item = {"seq": INPUT["seq"], "action": data.get("action"), "dart": data.get("dart"),
                        "index": data.get("index")}
                INPUT["items"] = (INPUT["items"] + [item])[-50:]
            return self.send(200, {"ok": True})
        if what == "board" and sub in BOARD_COMMANDS:
            ok, err = board_command(sub)
            with LOCK:
                SYSTEM_CACHE["data"] = None
                BOARD_CACHE["data"] = None
            return self.send(200 if ok else 502, {"ok": ok, "error": err})
        return self.send(404, {"error": "not found"})

    def do_PUT(self):
        parts, _ = self.parts()
        data = self.body()
        what = parts[1] if len(parts) > 1 else ""
        if what == "players" and len(parts) > 2:
            name = " ".join(str(data.get("name", "")).split())[:24]
            if not name:
                return self.send(400, {"error": "name required"})
            with LOCK:
                players = read_json(PLAYERS, [])
                if any(p["name"].lower() == name.lower() and p["id"] != parts[2] for p in players):
                    return self.send(409, {"error": "name already exists"})
                for p in players:
                    if p["id"] == parts[2]:
                        p["name"] = name
                write_json(PLAYERS, players)
            return self.send(200, {"ok": True})
        if what == "active":
            with LOCK:
                write_json(ACTIVE, data)
            return self.send(200, {"ok": True})
        return self.send(404, {"error": "not found"})

    def do_DELETE(self):
        parts, _ = self.parts()
        what = parts[1] if len(parts) > 1 else ""
        with LOCK:
            if what == "players" and len(parts) > 2:
                write_json(PLAYERS, [p for p in read_json(PLAYERS, []) if p["id"] != parts[2]])
                return self.send(200, {"ok": True})
            if what == "history" and len(parts) > 2:
                write_history([r for r in read_history() if r.get("id") != parts[2]])
                return self.send(200, {"ok": True})
            if what == "active":
                try:
                    os.remove(ACTIVE)
                except FileNotFoundError:
                    pass
                return self.send(200, {"ok": True})
        return self.send(404, {"error": "not found"})


def main():
    os.makedirs(DATA, exist_ok=True)
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    print(f"dartbox-playroom listening on :{PORT}, data in {DATA}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
