#!/usr/bin/env python3
"""dartbox-selftest: checks that an installation works (used after every update).

  dartbox-selftest [--wait SECONDS]

Checks: services running, hub answering on :80, playroom answering on :8081,
all dartbox Python programs compile. With --wait, retries until everything
passes or the time is up (services need a few seconds after a restart).
Exit code 0 = all good.
"""
import ast
import glob
import json
import subprocess
import sys
import time
import urllib.request

SERVICES = ["dartbox-netmgr", "dartbox-web", "dartbox-playroom", "dartbox-button", "dartbox-kiosk"]


def http(url, must_contain=None):
    with urllib.request.urlopen(url, timeout=5) as r:
        body = r.read().decode("utf-8", "replace")
        if r.status != 200:
            raise RuntimeError(f"HTTP {r.status}")
    if must_contain and must_contain not in body:
        raise RuntimeError(f"response lacks {must_contain!r}")
    return body


def checks():
    res = []
    for s in SERVICES:
        state = subprocess.run(["systemctl", "is-active", s], capture_output=True, text=True).stdout.strip()
        res.append((f"service {s}", state == "active", state))
    try:
        st = json.loads(http("http://127.0.0.1/api/status"))
        res.append(("hub :80 /api/status", "views" in st, ""))
    except Exception as e:  # noqa: BLE001
        res.append(("hub :80 /api/status", False, str(e)))
    try:
        http("http://127.0.0.1/", "Dartbox")
        res.append(("hub page", True, ""))
    except Exception as e:  # noqa: BLE001
        res.append(("hub page", False, str(e)))
    try:
        json.loads(http("http://127.0.0.1:8081/api/players"))
        http("http://127.0.0.1:8081/", "Playroom")
        res.append(("playroom :8081", True, ""))
    except Exception as e:  # noqa: BLE001
        res.append(("playroom :8081", False, str(e)))
    for f in glob.glob("/usr/local/bin/dartbox-*") + glob.glob("/usr/local/lib/dartbox/*.py"):
        try:
            with open(f, encoding="utf-8") as fh:
                src = fh.read()
            if src.startswith("#!/usr/bin/env python3") or f.endswith(".py"):
                ast.parse(src, f)
        except SyntaxError as e:
            res.append((f"compile {f}", False, str(e)))
    return res


def main(argv):
    wait = int(argv[argv.index("--wait") + 1]) if "--wait" in argv else 0
    deadline = time.monotonic() + wait
    while True:
        res = checks()
        ok = all(r[1] for r in res)
        if ok or time.monotonic() >= deadline:
            break
        time.sleep(3)
    for name, good, detail in res:
        print(("  ok   " if good else "  FAIL ") + name + (f"  ({detail})" if detail and not good else ""))
    print("self-test passed" if ok else "self-test FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
