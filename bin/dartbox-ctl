#!/usr/bin/env python3
"""dartbox-ctl: command line control (run as root).

  dartbox-ctl status
  dartbox-ctl hotspot                 enter setup hotspot mode
  dartbox-ctl forget                  forget all WiFi + hotspot
  dartbox-ctl connect SSID [PASSWORD]
"""
import json
import sys

sys.path.insert(0, "/usr/local/lib/dartbox")
from dartbox_common import STATUS_FILE, read_json, submit_request  # noqa: E402


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "status":
        print(json.dumps(read_json(STATUS_FILE, {}), indent=2))
    elif cmd == "hotspot":
        submit_request({"action": "hotspot"})
    elif cmd == "forget":
        submit_request({"action": "forget_all"})
    elif cmd == "connect" and len(argv) >= 3:
        submit_request({"action": "connect", "ssid": argv[2],
                        "password": argv[3] if len(argv) > 3 else ""})
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
